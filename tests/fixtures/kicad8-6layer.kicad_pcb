      (layer "In4.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 5" (type "prepreg") (thickness 0.1) (material "Prepreg B") (epsilon_r 4.2) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035))
