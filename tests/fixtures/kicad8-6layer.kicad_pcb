      (layer "In2.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 3" (type "prepreg") (thickness 0.2) (material "Prepreg B") (epsilon_r 4.2) (loss_tangent 0.02))
      (layer "In3.Cu" (type "copper") (thickness 0.0175))
